generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  rut          String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions             Session[]
  parkingSpots         ParkingSpot[]
  reservations         Reservation[]
  reviewsWritten       Review[]              @relation("ReviewsWritten")
  reviewsReceived      Review[]              @relation("ReviewsReceived")
  notifications        Notification[]
  identityVerification IdentityVerification?
  assignedTasks        Task[]
  passwordResetTokens  PasswordResetToken[]
  conversationsAsHost   Conversation[] @relation("ConversationsAsHost")
  conversationsAsRenter Conversation[] @relation("ConversationsAsRenter")
  messagesSent          Message[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Same pattern as Session: id is the SHA-256 hash of the raw token, never the token
/// itself — a leaked table never yields a usable reset link. One-hour expiry, single use.
model PasswordResetToken {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// One thread per (spot, renter) pair — not per reservation, so the same two people stay in
/// one conversation across an inquiry and any bookings that follow from it; not fully open
/// DMs either, since a thread only exists in the context of a specific spot. The host is
/// derived from the spot's owner at creation time, not stored redundantly on every message.
model Conversation {
  id        String   @id @default(uuid())
  spotId    String   @map("spot_id")
  hostId    String   @map("host_id")
  renterId  String   @map("renter_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spot     ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  host     User        @relation("ConversationsAsHost", fields: [hostId], references: [id], onDelete: Cascade)
  renter   User        @relation("ConversationsAsRenter", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([spotId, renterId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// No sensitive data on purpose: this is the only table exposed to Supabase Realtime,
/// so the browser can be told "something changed in <topic>" without ever seeing real rows.
model ChangeEvent {
  id        String   @id @default(uuid())
  topic     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("change_events")
}

model ParkingType {
  id   String @id @default(uuid())
  name String @unique

  parkingSpots ParkingSpot[]

  @@map("parking_types")
}

model ParkingSpot {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  parkingTypeId String   @map("parking_type_id")
  title         String
  area          String
  comuna        String?
  latitude      Float?
  longitude     Float?
  imageUrl      String?  @map("image_url")
  pricePerHour  Int      @map("price_per_hour")
  isPublished   Boolean  @default(false) @map("is_published")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parkingType   ParkingType    @relation(fields: [parkingTypeId], references: [id])
  availabilities Availability[]
  reservations  Reservation[]
  conversations Conversation[]

  @@map("parking_spots")
}

model Availability {
  id        String   @id @default(uuid())
  spotId    String   @map("spot_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  spot         ParkingSpot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@map("availabilities")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id               String            @id @default(uuid())
  spotId           String            @map("spot_id")
  userId           String            @map("user_id")
  availabilityId   String            @map("availability_id")
  startTime        DateTime          @map("start_time")
  endTime          DateTime          @map("end_time")
  totalPrice       Int               @map("total_price")
  status           ReservationStatus @default(PENDING)
  confirmationCode String            @unique @map("confirmation_code")
  createdAt        DateTime          @default(now()) @map("created_at")

  spot          ParkingSpot    @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  Availability   @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  reviews       Review[]
  payment       Payment?
  notifications Notification[]

  @@index([spotId, status])
  @@map("reservations")
}

enum ReviewDirection {
  RENTER_TO_HOST
  HOST_TO_RENTER
}

/// Not used by any feature yet — modeled ahead of time for the reviews/reputation phase.
model Review {
  id            String          @id @default(uuid())
  reservationId String          @map("reservation_id")
  authorId      String          @map("author_id")
  targetUserId  String          @map("target_user_id")
  direction     ReviewDirection
  rating        Int
  comment       String?
  createdAt     DateTime        @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  author      User        @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  target      User        @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([reservationId, authorId])
  @@map("reviews")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Not used by any feature yet — modeled ahead of time for the real-payments phase (Stripe/Webpay).
model Payment {
  id                String        @id @default(uuid())
  reservationId     String        @unique @map("reservation_id")
  amount            Int
  refundedAmount    Int           @default(0) @map("refunded_amount")
  status            PaymentStatus @default(PENDING)
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_REMINDER
  SPOT_PUBLISHED
  ADMIN_ALERT
}

/// In-app notification, optionally backed by an email send (sentAt is null if the email
/// failed or no provider is configured — the in-app row is still created either way).
model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  reservationId String?          @map("reservation_id")
  type          NotificationType
  title         String
  message       String
  readAt        DateTime?        @map("read_at")
  sentAt        DateTime?        @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Not used by any feature yet — modeled ahead of time for real identity verification
/// (today's face-scan step in Profile is a simulation and doesn't write here).
model IdentityVerification {
  id         String             @id @default(uuid())
  userId     String             @unique @map("user_id")
  status     VerificationStatus @default(PENDING)
  provider   String?
  verifiedAt DateTime?          @map("verified_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Admin-only project roadmap board (Panel de administración → Tareas Pendientes).
/// Columns are TaskStatus — a real Kanban board, not just a checklist.
/// Not tied to any product feature — internal task tracking for the team.
model Task {
  id           String     @id @default(uuid())
  epic         String
  title        String
  order        Int        @default(0)
  status       TaskStatus @default(TODO)
  assignedToId String?    @map("assigned_to_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("tasks")
}
